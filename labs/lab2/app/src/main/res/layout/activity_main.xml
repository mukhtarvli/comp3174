<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F5F7FA">

    <ImageView
        android:id="@+id/imageLogo"
        android:layout_width="110dp"
        android:layout_height="110dp"
        android:contentDescription="App logo"
        android:src="@mipmap/ic_launcher"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginTop="64dp" />

    <TextView
        android:id="@+id/textViewOutput"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="0"
        android:textSize="48sp"
        android:textStyle="bold"
        android:textColor="#1F2937"
        android:layout_marginTop="36dp"
        app:layout_constraintTop_toBottomOf="@id/imageLogo"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <Button
        android:id="@+id/buttonSubtract"
        android:layout_width="130dp"
        android:layout_height="wrap_content"
        android:text="-"
        android:textSize="24sp"
        android:textColor="#FFFFFF"
        android:backgroundTint="#E74C3C"
        android:layout_marginTop="36dp"
        android:layout_marginEnd="12dp"
        app:layout_constraintTop_toBottomOf="@id/textViewOutput"
        app:layout_constraintEnd_toStartOf="@id/buttonAdd"
        app:layout_constraintStart_toStartOf="parent" />

    <Button
        android:id="@+id/buttonAdd"
        android:layout_width="130dp"
        android:layout_height="wrap_content"
        android:text="+"
        android:textSize="24sp"
        android:textColor="#FFFFFF"
        android:backgroundTint="#27AE60"
        android:layout_marginTop="36dp"
        android:layout_marginStart="12dp"
        app:layout_constraintTop_toBottomOf="@id/textViewOutput"
        app:layout_constraintStart_toEndOf="@id/buttonSubtract"
        app:layout_constraintEnd_toEndOf="parent" />

    <Button
        android:id="@+id/buttonReset"
        android:layout_width="130dp"
        android:layout_height="wrap_content"
        android:text="Reset"
        android:textColor="#FFFFFF"
        android:backgroundTint="#E91E63"
        android:layout_marginTop="24dp"
        android:layout_marginEnd="12dp"
        app:layout_constraintTop_toBottomOf="@id/buttonSubtract"
        app:layout_constraintEnd_toStartOf="@id/buttonStep"
        app:layout_constraintStart_toStartOf="parent" />

    <Button
        android:id="@+id/buttonStep"
        android:layout_width="130dp"
        android:layout_height="wrap_content"
        android:text="Step"
        android:textColor="#FFFFFF"
        android:backgroundTint="#3498DB"
        android:layout_marginTop="24dp"
        android:layout_marginStart="12dp"
        app:layout_constraintTop_toBottomOf="@id/buttonAdd"
        app:layout_constraintStart_toEndOf="@id/buttonReset"
        app:layout_constraintEnd_toEndOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>