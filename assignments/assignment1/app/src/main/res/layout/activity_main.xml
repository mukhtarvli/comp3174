<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/payroll_calculator"
            android:textSize="26sp"
            android:textStyle="bold"
            android:layout_gravity="center_horizontal"
            android:layout_marginBottom="24dp" />

        <EditText
            android:id="@+id/etHoursWorked"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/number_of_hours_worked"
            android:inputType="numberDecimal" />

        <EditText
            android:id="@+id/etHourlyRate"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/hourly_rate_example_20_00"
            android:inputType="numberDecimal"
            android:layout_marginTop="16dp" />

        <EditText
            android:id="@+id/etTaxRate"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/tax_rate_example_0_13"
            android:inputType="numberDecimal"
            android:layout_marginTop="16dp" />

        <Button
            android:id="@+id/btnCalculate"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/calculate"
            android:layout_marginTop="24dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/results"
            android:textSize="20sp"
            android:textStyle="bold"
            android:layout_marginTop="28dp"
            android:layout_marginBottom="8dp" />

        <TextView
            android:id="@+id/tvPay"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/pay_0_00"
            android:textSize="18sp"
            android:layout_marginTop="8dp" />

        <TextView
            android:id="@+id/tvOvertimePay"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/overtime_pay_0_00"
            android:textSize="18sp"
            android:layout_marginTop="8dp" />

        <TextView
            android:id="@+id/tvTotalPay"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/total_pay_0_00"
            android:textSize="18sp"
            android:textStyle="bold"
            android:layout_marginTop="8dp" />

        <TextView
            android:id="@+id/tvTax"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/tax_0_00"
            android:textSize="18sp"
            android:layout_marginTop="8dp" />

        <Button
            android:id="@+id/btnAbout"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/about"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="28dp" />

    </LinearLayout>

</ScrollView>